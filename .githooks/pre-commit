#!/usr/bin/env bash
# Runs before every commit:
# 1. `make lint`. A lint failure stops the commit.
# 2. `make sync`, which regenerates every generated file. The Makefile is the
#    only list of generators and their order. A generator failure (for
#    example, no network for the dcurves count) prints a warning but does not
#    stop the commit, and the other generators still run (make -k).
# 3. Stages the regenerated files.
# Enable once per clone with: git config core.hooksPath .githooks
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# Lint first. A lint failure stops the commit.
if ! command -v ruff >/dev/null; then
  echo "pre-commit: ruff is missing. Install it with: uv tool install ruff" >&2
  exit 1
fi
make -C "$repo_root" --no-print-directory lint

if ! make -C "$repo_root" --no-print-directory -k sync; then
  echo "pre-commit: a generator failed (see above). Committing with the files as they are." >&2
fi

git add -A "$repo_root/site" "$repo_root/docs/all-experiences.md"
