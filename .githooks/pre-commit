#!/usr/bin/env bash
# Keeps generated/synced content current before every commit:
# - site/resume.html and docs/all-experiences.md, regenerated from
#   data/experiences.json (single source of truth — do not hand-edit the
#   RESUME or RECORD marker blocks)
# - dcurves download count in site/resume.html (must run AFTER gen_resume.py,
#   since gen_resume.py writes a static placeholder for that count)
# - the shared nav (templates/nav.html) stamped into every page under site/
# - SEO/social meta tags on every page + auto-discovered post under site/posts/
# - site/sitemap.xml
# - the blog listing in site/index.html
# Adding a new post is just: create site/posts/<slug>/index.html (+ optional
# .draft file) and commit — everything above regenerates automatically.
# Enable once per clone with: git config core.hooksPath .githooks
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# Lint first. A lint failure stops the commit.
if ! command -v ruff >/dev/null; then
  echo "pre-commit: ruff is missing. Install it with: uv tool install ruff" >&2
  exit 1
fi
make -C "$repo_root" --no-print-directory lint

python3 "$repo_root/scripts/gen_resume.py" || true
python3 "$repo_root/scripts/gen_record.py" || true
"$repo_root/scripts/update-dcurves-downloads.sh" || true
python3 "$repo_root/scripts/sync_nav.py" || true
python3 "$repo_root/scripts/sync_seo.py" || true
python3 "$repo_root/scripts/sync_social.py" || true
python3 "$repo_root/scripts/gen_blog_index.py" || true
python3 "$repo_root/scripts/gen_sitemap.py" || true

git add -A "$repo_root/site" "$repo_root/docs/all-experiences.md"
