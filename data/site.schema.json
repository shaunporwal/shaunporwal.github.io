{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Site constants",
  "description": "The name, canonical base URL, summary, and contact links for the whole site.",
  "type": "object",
  "$defs": {
    "mediaPath": {
      "description": "A file in site/media, as a path from the site root.",
      "type": "string",
      "pattern": "^/media/"
    },
    "picture": {
      "description": "The picture that leads a Work card. Its kind picks how scripts/lib_pictures.py draws it: a clip (a looping silent video with a still), a logo, or a decision curve that scripts/lib_curve_svg.py draws as inline SVG. Each kind needs its own keys.",
      "type": "object",
      "required": ["kind", "alt"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["clip", "logo", "decision-curve"] },
        "alt": { "description": "What the picture shows, for a screen reader.", "type": "string" },
        "still": { "description": "A clip: the poster image, 16:10.", "$ref": "#/$defs/mediaPath" },
        "mp4": { "description": "A clip: the MP4 source.", "$ref": "#/$defs/mediaPath" },
        "webm": { "description": "A clip: the WebM source.", "$ref": "#/$defs/mediaPath" },
        "image": { "description": "A logo: the image.", "$ref": "#/$defs/mediaPath" },
        "note": { "description": "A decision curve: the visible label that says the curve is not real data.", "type": "string" },
        "prevalence": { "description": "A decision curve: the share of cases, between 0 and 1.", "type": "number" },
        "separation": { "description": "A decision curve: how far apart the model scores of the two groups are.", "type": "number" },
        "threshold": { "description": "A decision curve: where the live point sits, between 0 and 0.5.", "type": "number" },
        "lines": {
          "description": "A decision curve: the direct label of each line.",
          "type": "object",
          "required": ["model", "all", "none"],
          "additionalProperties": false,
          "properties": {
            "model": { "type": "string" },
            "all": { "type": "string" },
            "none": { "type": "string" }
          }
        }
      },
      "anyOf": [
        { "properties": { "kind": { "enum": ["clip"] } }, "required": ["still", "mp4", "webm"] },
        { "properties": { "kind": { "enum": ["logo"] } }, "required": ["image"] },
        {
          "properties": { "kind": { "enum": ["decision-curve"] } },
          "required": ["note", "prevalence", "separation", "threshold", "lines"]
        }
      ]
    }
  },
  "required": [
    "name",
    "base_url",
    "email",
    "github",
    "x",
    "linkedin",
    "cal",
    "profiles",
    "og_image_path",
    "summary",
    "job_title",
    "hero",
    "projects",
    "seo",
    "avatar_path",
    "work",
    "icons"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "base_url": {
      "description": "The canonical origin, with no trailing slash. site/CNAME is generated from its host.",
      "type": "string",
      "pattern": "^https://[a-z0-9.-]+$"
    },
    "email": {
      "type": "string"
    },
    "github": {
      "type": "string",
      "pattern": "^https://"
    },
    "x": {
      "type": "string",
      "pattern": "^https://"
    },
    "linkedin": {
      "type": "string",
      "pattern": "^https://"
    },
    "cal": {
      "type": "string",
      "pattern": "^https://"
    },
    "profiles": {
      "description": "The author's profiles in display order. Each key names a profile URL above. The footer, the About buttons, llms.txt and the Person JSON-LD list them.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "key"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "key": { "enum": ["github", "x", "linkedin"] }
        }
      }
    },
    "og_image_path": {
      "description": "The default social preview image, as a path from the site root.",
      "type": "string",
      "pattern": "^/"
    },
    "summary": {
      "description": "One sentence about the site, used at the top of site/llms.txt.",
      "type": "string"
    },
    "job_title": {
      "description": "The job title in the Person JSON-LD and the agent files.",
      "type": "string"
    },
    "hero": {
      "description": "The home page hero text.",
      "type": "object",
      "required": [
        "lead"
      ],
      "additionalProperties": false,
      "properties": {
        "lead": {
          "type": "string"
        }
      }
    },
    "projects": {
      "description": "The Work cards on the home page and the Work list in llms.txt.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url",
          "summary",
          "picture"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "summary": {
            "description": "One short sentence under the name on the card.",
            "type": "string"
          },
          "picture": {
            "$ref": "#/$defs/picture"
          }
        }
      }
    },
    "seo": {
      "description": "What crawlers and agents may do. Generates robots.txt, agents.txt and agents.json.",
      "type": "object",
      "required": [
        "crawlers",
        "agents"
      ],
      "additionalProperties": false,
      "properties": {
        "crawlers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agents": {
          "type": "object",
          "required": [
            "summary",
            "may",
            "may_not"
          ],
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "string"
            },
            "may": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "may_not": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "brand": {
      "description": "Phrases that the built pages and discovery files must never hold. Junto is the company that makes the lab modern, not a software company. tests/test_brand_copy.py enforces it.",
      "type": "object",
      "required": ["avoid"],
      "additionalProperties": false,
      "properties": {
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "avatar_path": {
      "description": "The portrait on the home page and in the Person JSON-LD, as a path from the site root.",
      "type": "string",
      "pattern": "^/"
    },
    "work": {
      "description": "The heading of the Work cards on the home page.",
      "type": "object",
      "required": [
        "eyebrow",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "icons": {
      "description": "The icon files in site/media, as paths from the site root. They go in the head of every page and in manifest.webmanifest.",
      "type": "object",
      "required": [
        "svg",
        "png",
        "apple",
        "manifest"
      ],
      "additionalProperties": false,
      "properties": {
        "svg": {
          "type": "string",
          "pattern": "^/"
        },
        "png": {
          "type": "string",
          "pattern": "^/"
        },
        "apple": {
          "type": "string",
          "pattern": "^/"
        },
        "manifest": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "size"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "size": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
