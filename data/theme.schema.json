{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theme tokens",
  "description": "The color, type and motion tokens of the Junto theme family. Generates the THEME block in site/styles/site.css. The neutrals, radius, ease and grid match cheminventory.co. The primary color is this site's accent.",
  "type": "object",
  "required": [
    "light",
    "dark",
    "fixed"
  ],
  "additionalProperties": false,
  "properties": {
    "light": {
      "type": "object",
      "required": [
        "background",
        "foreground",
        "card",
        "secondary",
        "muted-foreground",
        "border",
        "input",
        "primary",
        "primary-foreground",
        "ring",
        "glow-tint",
        "glow-on-primary",
        "sheen",
        "shadow-raise",
        "shadow-raise-primary",
        "shadow-header"
      ],
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "foreground": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "card": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "secondary": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "muted-foreground": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "border": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "input": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "primary": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "primary-foreground": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "ring": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "glow-tint": {
          "description": "The light that follows the pointer on a card or an outline button.",
          "type": "string",
          "pattern": "^(#[0-9a-f]{6}|rgba\\(\\d{1,3}, \\d{1,3}, \\d{1,3}, [01]?\\.?\\d+\\))$"
        },
        "glow-on-primary": {
          "description": "The same light on the primary button.",
          "type": "string",
          "pattern": "^(#[0-9a-f]{6}|rgba\\(\\d{1,3}, \\d{1,3}, \\d{1,3}, [01]?\\.?\\d+\\))$"
        },
        "sheen": {
          "description": "The light that circles the main button.",
          "type": "string",
          "pattern": "^(#[0-9a-f]{6}|rgba\\(\\d{1,3}, \\d{1,3}, \\d{1,3}, [01]?\\.?\\d+\\))$"
        },
        "shadow-raise": {
          "description": "An outline button: edge light on top, a ring and a small drop.",
          "type": "string"
        },
        "shadow-raise-primary": {
          "description": "The primary button: the same edge light and a colored drop.",
          "type": "string"
        },
        "shadow-header": {
          "description": "The header after the page scrolls.",
          "type": "string"
        }
      }
    },
    "dark": {
      "type": "object",
      "required": [
        "background",
        "foreground",
        "card",
        "secondary",
        "muted-foreground",
        "border",
        "input",
        "primary",
        "primary-foreground",
        "ring",
        "glow-tint",
        "glow-on-primary",
        "sheen",
        "shadow-raise",
        "shadow-raise-primary",
        "shadow-header"
      ],
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "foreground": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "card": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "secondary": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "muted-foreground": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "border": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "input": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "primary": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "primary-foreground": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "ring": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "glow-tint": {
          "description": "The light that follows the pointer on a card or an outline button.",
          "type": "string",
          "pattern": "^(#[0-9a-f]{6}|rgba\\(\\d{1,3}, \\d{1,3}, \\d{1,3}, [01]?\\.?\\d+\\))$"
        },
        "glow-on-primary": {
          "description": "The same light on the primary button.",
          "type": "string",
          "pattern": "^(#[0-9a-f]{6}|rgba\\(\\d{1,3}, \\d{1,3}, \\d{1,3}, [01]?\\.?\\d+\\))$"
        },
        "sheen": {
          "description": "The light that circles the main button.",
          "type": "string",
          "pattern": "^(#[0-9a-f]{6}|rgba\\(\\d{1,3}, \\d{1,3}, \\d{1,3}, [01]?\\.?\\d+\\))$"
        },
        "shadow-raise": {
          "description": "An outline button: edge light on top, a ring and a small drop.",
          "type": "string"
        },
        "shadow-raise-primary": {
          "description": "The primary button: the same edge light and a colored drop.",
          "type": "string"
        },
        "shadow-header": {
          "description": "The header after the page scrolls.",
          "type": "string"
        }
      }
    },
    "fixed": {
      "type": "object",
      "required": [
        "font-sans",
        "font-serif",
        "radius",
        "ease-out",
        "shell",
        "measure",
        "shadow-menu",
        "glow-size",
        "motion-glow",
        "motion-follow",
        "sheen-duration"
      ],
      "additionalProperties": false,
      "properties": {
        "font-sans": {
          "type": "string"
        },
        "font-serif": {
          "type": "string"
        },
        "radius": {
          "type": "string"
        },
        "ease-out": {
          "type": "string"
        },
        "shell": {
          "type": "string"
        },
        "measure": {
          "type": "string"
        },
        "shadow-menu": {
          "description": "The drop shadow under the open phone menu.",
          "type": "string"
        },
        "glow-size": {
          "description": "The radius of the light that follows the pointer.",
          "type": "string"
        },
        "motion-glow": {
          "description": "How long the pointer light takes to fade in and out.",
          "type": "string"
        },
        "motion-follow": {
          "description": "How long the pointer light takes to catch up with the pointer.",
          "type": "string"
        },
        "sheen-duration": {
          "description": "How long the edge light takes for one turn.",
          "type": "string"
        }
      }
    }
  }
}
